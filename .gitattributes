# Normalize line endings: LF in the repo and on checkout, so Windows and CI
# (Linux) see byte-identical sources and `prettier --check` is deterministic.
* text=auto eol=lf

# Binary assets — never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary

# Lockfile is generated; keep it out of diffs/language stats.
package-lock.json -diff linguist-generated=true

# Shell/build scripts must stay LF even on Windows.
*.sh text eol=lf
